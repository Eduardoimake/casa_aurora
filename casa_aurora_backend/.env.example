# Exemplo EXCLUSIVAMENTE para desenvolvimento local.
# Copie para .env e adicione uma DJANGO_SECRET_KEY gerada por você.
# Nunca versionar .env nem usar esta configuração como produção.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false

# Exemplo: frontend em http://localhost:5173; API em http://localhost:8000.
# Use exatamente o hostname e a porta presentes na barra de endereço.
# Se o frontend usar 127.0.0.1, ajuste as duas origens para 127.0.0.1.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3

MAX_IMAGE_UPLOAD_MB=5

# Produção: forneça as configurações necessárias no ambiente do processo.
# Não habilite DEBUG e não registre segredos neste arquivo de exemplo.
#
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=definir_no_ambiente_de_producao
# DJANGO_ALLOWED_HOSTS=dominio-da-aplicacao.example
# DB_ENGINE=postgresql
# DB_NAME=definir_no_ambiente
# DB_USER=definir_no_ambiente
# DB_PASSWORD=definir_no_ambiente
# DB_HOST=definir_no_ambiente
# DB_PORT=5432
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_TRUST_PROXY_SSL_HEADER=false
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false